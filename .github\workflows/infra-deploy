name: Deploy Infrastructure
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'infra-config/**'
      - '.github/workflows/infra-deploy.yml'
jobs:
  deploy-infra:
    runs-on: ubuntu-latest
    environment: dev
    steps:
      - name: Checkout cloud-devops-templates
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.G_TOKEN }}   # ← fix: authenticate against private repo

      - name: Copy infra configs to droplet
        uses: appleboy/scp-action@v0.1.7
        with:
          host: ${{ secrets.DROPLET_IP }}
          username: deploy
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          source: "infra-config/"
          target: "/opt/infra"
          strip_components: 1
      - name: Deploy infra services
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.DROPLET_IP }}
          username: deploy
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            cd /opt/infra
            docker compose -f docker-compose.infra.yml pull
            docker compose -f docker-compose.infra.yml up -d --remove-orphans
            docker compose -f docker-compose.infra.yml ps
            echo "✅ Infra deployed"
